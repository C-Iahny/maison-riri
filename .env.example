# Copier en .env puis charger les variables avant de lancer le serveur.
DJANGO_SECRET_KEY=changez-cette-cle
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=maison-riri.com,www.maison-riri.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://maison-riri.com,https://www.maison-riri.com

# Dossier des données persistantes (base + images envoyées). À laisser vide en
# local ; sur un hébergeur à conteneurs, pointer vers le volume monté.
DJANGO_DATA_DIR=

# Coordonnées affichées sur le site
MRD_EMAIL=contact@maisonriridesign.com
MRD_PHONE=
MRD_INSTAGRAM=https://www.instagram.com/maisonriridesign
MRD_FACEBOOK=

# Recopie des demandes vers le Google Form existant
MRD_GOOGLE_FORM_ENABLED=1
MRD_GOOGLE_FORM_ACTION=https://docs.google.com/forms/d/e/1FAIpQLSfqS62pgb44k0osi1hDn9S3DV0xWws3nHlLE-y9oZwQEX0J2A/formResponse

# Notification par e-mail à chaque demande
MRD_NOTIFY_EMAILS=contact@maisonriridesign.com
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=1
DJANGO_DEFAULT_FROM_EMAIL=Maison Riri Design <no-reply@maisonriridesign.com>
